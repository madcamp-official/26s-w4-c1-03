<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider path config. CaptureRepository.capturesDir()
  (data/CaptureRepository.kt) writes photos to context.filesDir/captures/ —
  internal storage, not directly accessible to other apps, hence the need for a
  content:// URI via FileProvider.

  The <provider> entry referencing "@xml/file_paths" is in AndroidManifest.xml.

  Nothing in the app hands a URI out today: the 2f design's bottom row is one
  save button, with no share action. This stays declared because the provider is
  registered and a path list that does not match the directories in use is worse
  than one that is simply unused.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="captures" path="captures/" />
</paths>
