<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider path config for OS-share-sheet sharing (§6-3: "공유는 OS 공유 시트만").
  CaptureRepository.capturesDir() (data/CaptureRepository.kt, owned by local-edit-agent)
  writes photos to context.filesDir/captures/ — internal storage, not directly
  accessible to other apps, hence the need for a content:// URI via FileProvider.

  The <provider> entry referencing "@xml/file_paths" is in AndroidManifest.xml.

  `edits/` is here as well as `captures/`: §4-2's share button hands out the
  *edited* result, which saveEditedCapture writes to filesDir/edits/. Sharing from
  a directory the provider does not cover throws IllegalArgumentException at the
  moment the user taps 공유 — a path no unit test can reach, so it has to be right
  by inspection.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="captures" path="captures/" />
    <files-path name="edits" path="edits/" />
</paths>
