<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Reading images (gallery import / reference pick). Split by API level.
         READ_MEDIA_VISUAL_USER_SELECTED accepts Android 14+'s "selected photos
         only" choice — without it that choice would dead-lock the permission gate. -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Gallery export uses MediaStore. WRITE_EXTERNAL_STORAGE is gone: it only ever
         applied to API ≤28, and minSdk is now 29 (scoped storage), so the declaration
         could never take effect. It was also never requested at runtime, which is what
         made the API 26~28 export fail silently. -->

    <!-- Network (presets / references analyze / edit-jobs) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- allowBackup=false: D4 promises "앱 삭제 = 데이터 소실". Auto Backup would
         restore the device UUID and DB (with stale absolute file paths) after
         reinstall, breaking that promise. -->
    <application
        android:name=".GamdoApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Gamdo"
        tools:targetApi="31">

        <!-- ML Kit Subject Segmentation model. The model is downloaded by Google
             Play services; the camera path falls back to object detection while
             it is unavailable. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />

        <!-- Portrait-locked (t2 design is portrait-only): the aspect-mask layout
             assumes portrait, and rotation would recreate the activity mid-capture. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Gamdo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OS share sheet (§6-3: "공유는 OS 공유 시트만"). Photos live in
             filesDir/captures/ (internal storage), so sharing them out needs a
             content:// URI. exported=false + grantUriPermissions: the receiving
             app gets read access only for the URI we hand it, per Intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
