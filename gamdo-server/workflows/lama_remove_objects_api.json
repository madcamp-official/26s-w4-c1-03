{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "${INPUT_IMAGE}"
    }
  },
  "2": {
    "class_type": "INPAINT_LoadInpaintModel",
    "inputs": {
      "model_name": "big-lama.pt"
    }
  },
  "3": {
    "class_type": "INPAINT_InpaintWithModel",
    "inputs": {
      "inpaint_model": ["2", 0],
      "image": ["1", 0],
      "mask": ["1", 1],
      "seed": "${SEED}"
    }
  },
  "4": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["3", 0],
      "filename_prefix": "gamdo_lama"
    }
  }
}
