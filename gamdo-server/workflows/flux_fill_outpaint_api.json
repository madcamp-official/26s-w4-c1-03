{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "${INPUT_IMAGE}"
    }
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "clip_l.safetensors",
      "clip_name2": "t5xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "flux",
      "device": "default"
    }
  },
  "3": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux1-fill-dev.safetensors",
      "weight_dtype": "default"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "natural photographic continuation of the existing scene, preserve perspective, lighting, textures, and subject identity, seamless realistic background",
      "clip": ["2", 0]
    }
  },
  "6": {
    "class_type": "FluxGuidance",
    "inputs": {
      "conditioning": ["5", 0],
      "guidance": 30.0
    }
  },
  "7": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": ["5", 0]
    }
  },
  "8": {
    "class_type": "DifferentialDiffusion",
    "inputs": {
      "model": ["3", 0],
      "strength": 1.0
    }
  },
  "9": {
    "class_type": "InpaintModelConditioning",
    "inputs": {
      "positive": ["6", 0],
      "negative": ["7", 0],
      "vae": ["4", 0],
      "pixels": ["1", 0],
      "mask": ["1", 1],
      "noise_mask": true
    }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["8", 0],
      "seed": "${SEED}",
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "positive": ["9", 0],
      "negative": ["9", 1],
      "latent_image": ["9", 2],
      "denoise": 1.0
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["10", 0],
      "vae": ["4", 0]
    }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["11", 0],
      "filename_prefix": "gamdo_flux_fill"
    }
  }
}
