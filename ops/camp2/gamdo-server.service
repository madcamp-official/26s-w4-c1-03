[Unit]
Description=GAMDO FastAPI server on CAMP-2
After=network-online.target gamdo-comfyui.service
Wants=network-online.target
Requires=gamdo-comfyui.service

[Service]
Type=simple
WorkingDirectory=/opt/gamdo/server
EnvironmentFile=/etc/gamdo/gamdo.env
ExecStart=/opt/gamdo/server-venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
