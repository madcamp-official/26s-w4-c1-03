[Unit]
Description=GAMDO IC-Light relight service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/gamdo/server
EnvironmentFile=/etc/gamdo/gamdo.env
ExecStart=/opt/gamdo/model-services/iclight-venv/bin/uvicorn model_services.iclight_service:app --host 127.0.0.1 --port 8191
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
